  "translation": {
    "engine": "claude",
    "fallback_order": ["claude"],
    "canonical_locale": "en-US",
    "target_locales": ["en", "zh-Hans"],
    "source_langs": [],
    "hot_percent": 10,
    "batch_size": 10
  },

  "data_retention": {
    "retention_days": 30
  }
