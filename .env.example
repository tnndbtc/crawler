# Environment variables for crawler project

# Django settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# SQLite path (default: db.sqlite3 in project root)
# DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (future):
# DATABASE_URL=postgresql://user:password@localhost:5432/crawler_db

# Translation API Keys
DEEPL_API_KEY=your-deepl-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8000

# Observability & Safety (NEW from /tmp/t8)
DRY_RUN=false                    # Set to 'true' for testing without storing data
MAX_RUN_SECONDS=60               # Timeout per surface execution (prevents hangs)

# Worker settings
SURFACE_WORKER_POLL_INTERVAL=60  # seconds
TRANSLATION_WORKER_POLL_INTERVAL=30  # seconds

# Logging
LOG_LEVEL=INFO
